{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/home.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/aurora-private-:loc(bonaire|india|mauritius|marbella).html",
      "destination": "/:loc",
      "permanent": true
    },
    {
      "source": "/:loc(bonaire|india|mauritius|marbella).html",
      "destination": "/:loc",
      "permanent": true
    },
    {
      "source": "/excursie-:loc(bonaire|india|mauritius|marbella)-:slug.html",
      "destination": "/:loc/:slug",
      "permanent": true
    },
    {
      "source": "/aurora-private-:loc(bonaire|india|mauritius|marbella)-excursie-:slug.html",
      "destination": "/:loc",
      "permanent": true
    },
    {
      "source": "/review",
      "destination": "/intern/index.html",
      "permanent": false
    },
    {
      "source": "/pitch",
      "destination": "/intern/pitch.html",
      "permanent": false
    },
    {
      "source": "/aurora-private-:loc(bonaire|india|mauritius|marbella)",
      "destination": "/:loc",
      "permanent": true
    },
    {
      "source": "/excursie-:loc(bonaire|india|mauritius|marbella)-:slug",
      "destination": "/:loc/:slug",
      "permanent": true
    },
    {
      "source": "/aurora-private-:loc(bonaire|india|mauritius|marbella)-excursie-:slug",
      "destination": "/:loc",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://images.unsplash.com; font-src 'self'; connect-src 'self'; media-src 'self' https://assets.mixkit.co; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=(), browsing-topics=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/intern/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://images.unsplash.com; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
---
// Excursion pages: one template, content in src/data/excursions.json.
// A new excursion = one JSON entry + three images in src/assets/img.
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import excursions from '../../data/excursions.json';
import { locName } from '../../data/site';

export function getStaticPaths() {
  return excursions.map((e) => ({ params: { loc: e.loc, slug: e.slug }, props: { e } }));
}
type E = (typeof excursions)[number];
const { e } = Astro.props as { e: E };
const name = locName(e.loc);
const siblings = excursions.filter((x) => x.loc === e.loc);
const others = siblings.filter((x) => x.slug !== e.slug);
const arrow = '<svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12 H21 M15 6 L21 12 L15 18" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const talk = `/${e.loc}#gesprek`;
const hasStock = e.beats.some((b) => b.photo.startsWith('unsplash:'));
const credit = hasStock
  ? 'Tijden en duur zijn indicatief en volgen bij de planning van de editie. Beelden zijn tijdelijke stockfoto’s (Unsplash) en sfeerconcepten, geen foto’s van de excursie of een partner.'
  : e.credit;
---
<Base
  title={e.metaTitle}
  description={e.description}
  current={e.loc as any}
  og={`${e.loc}-${e.slug}`}
  talk={talk}
  crumbs={[{ name, path: `/${e.loc}` }, { name: e.title, path: `/${e.loc}/${e.slug}` }]}
>
<section class="story" aria-labelledby="exc-h">
<div class="ribbon"><div class="wrap"><div class="glass glass--bar"><span><a href={`/${e.loc}`}>{name}</a> · Excursie {e.order} van {siblings.length}</span><span class="rw">{e.when.split(' · ')[0]}</span></div></div></div>
<div class="frames">
  {e.beats.map((b, i) => (
    <div class:list={['beat', { on: i === 0 }]}>
      <Photo src={b.photo} alt={b.alt} priority={i === 0} />
      <div class="shade" aria-hidden="true"></div>
      <div class="txt"><div class="wrap">
        {i === 0 ? (
          <>
            <span class="eyebrow">{b.eyebrow}</span>
            <h1 id="exc-h">{e.title}</h1>
            <p class="line" style="margin-top:20px">{b.line}</p>
          </>
        ) : (
          <>
            <span class="k">{b.label}</span>
            <p class="line">{b.line}</p>
          </>
        )}
      </div></div>
    </div>
  ))}
</div></section>
<section class="section tone-dusk" aria-labelledby="praktisch-t"><div class="wrap">
  <div class="still reveal" style="margin-bottom:clamp(64px,8vw,112px)">
    <span class="eyebrow">Praktisch</span>
    <h2 class="statement" id="praktisch-t">{e.practical.heading}</h2>
    <p class="soft">{e.practical.lead}</p>
    <details class="more"><summary>Meer details</summary><div><p>{e.practical.body}</p><p class="credit">{credit}</p></div></details>
  </div>
  <dl class="facts reveal">{e.facts.map((f) => <div><dt>{f.dt}</dt><dd>{f.dd}</dd></div>)}</dl>
</div></section>
<section class="section tone-dawn" aria-labelledby="meer-t" style={`--loc:var(--${e.loc})`}><div class="wrap">
  <div class="head reveal">
    <div class="stack"><span class="eyebrow">Meer in {name}</span><h2 class="h2" id="meer-t">De andere middagen</h2></div>
    <a class="link" href={`/${e.loc}#excursies`}>Terug naar {name} <Fragment set:html={arrow} /></a>
  </div>
  <div class="excs excs--3 reveal">
    {others.map((o) => (
      <a class="exc" href={`/${o.loc}/${o.slug}`}>
        <Photo src={o.card.photo} alt="" class="thumb" sizes="(max-width: 960px) 50vw, 33vw" />
        <span class="when">{o.card.when}</span><h3>{o.title}</h3>
      </a>
    ))}
  </div>
  <div class="center" style="margin-top:clamp(72px,9vw,128px)"><a class="btn" href={talk}>Een eerste gesprek</a></div>
</div></section>
</Base>

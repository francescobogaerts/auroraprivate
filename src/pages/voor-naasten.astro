---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import IntakeSection from '../components/IntakeSection.astro';
---
<Base title="Voor naasten · AURORA Private" description="Je ziet het bij iemand van wie je houdt. Hoe je het gesprek begint, wat je wel en niet kunt doen, en hoe je een eerste gesprek aanvraagt." og="naasten" crumbs={[{ name: 'Voor naasten', path: '/voor-naasten' }]}>
<PageHero photo="unsplash:1771422574900-4566f20c01d4" alt="Twee koppen koffie op een houten tafel in laag licht." eyebrow="Voor naasten" title="Je ziet het bij iemand van wie je houdt." sub="Je kunt het niet voor een ander oplossen. Wel de eerste stap makkelijker maken." focal="50% 70%" />

<section class="section" aria-labelledby="b-t"><div class="wrap">
  <div class="head reveal"><div class="stack"><span class="eyebrow">Het gesprek beginnen</span><h2 class="h2" id="b-t">Zonder ultimatum. Zonder <em>diagnose</em>.</h2></div></div>
  <ol class="steps reveal">
    <li><div><h3>Kies een rustig moment</h3><p>Een wandeling of autorit werkt vaak beter dan tegenover elkaar aan tafel.</p></div></li>
    <li><div><h3>Vertel wat je ziet</h3><p>Niet wat de ander is. Spreek vanuit jezelf.</p></div></li>
    <li><div><h3>Luister langer dan je praat</h3><p>Je hoeft niet alle antwoorden te hebben. Laat stiltes bestaan.</p></div></li>
    <li><div><h3>Laat de keuze bij de ander</h3><p>Druk werkt tegen. Bied aan om samen een eerste gesprek te voeren.</p></div></li>
  </ol>
</div></section>

<section class="section section--s band" aria-labelledby="w-t"><div class="wrap still reveal">
  <span class="eyebrow">Wat wij kunnen doen</span>
  <p class="statement" id="w-t" style="color:var(--salt)">Je kunt het eerste gesprek ook voor iemand <em>anders</em> aanvragen.</p>
  <p class="soft" style="color:var(--on-band-soft)">Vertrouwelijk, zonder namen. De intake zelf voeren we altijd met de deelnemer.</p>
</div></section>

<section class="section section--s" aria-labelledby="acuut-t"><div class="wrap">
  <h2 class="sr" id="acuut-t">Als het acuut is</h2>
  <div class="notice" style="margin:0 auto"><p><strong>Als het acuut is, wacht niet op een intake.</strong> Bij direct gevaar: 112. Zorgen over zelfdoding: 113 Zelfmoordpreventie, 0800-0113 of 113.nl, gratis en anoniem, ook voor naasten. De huisarts is het eerste aanspreekpunt voor zorg.</p></div>
</div></section>

<IntakeSection title="Een gesprek als naaste." lead="Kies ‘Voor een naaste’. Je hoeft nog niets te beslissen." />
</Base>

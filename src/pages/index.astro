---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import IntakeSection from '../components/IntakeSection.astro';
import locations from '../data/locations.json';
const arrow = '<svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12 H21 M15 6 L21 12 L15 18" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const hints: Record<string, string> = {
  bonaire: 'Rif, zoutpannen en wind.',
  india: 'Stilte aan de rivier.',
  mauritius: 'Lagune en basalt.',
  marbella: 'Sierra en zee, dicht bij huis.',
};
---
<Base title="AURORA Private" description="Zes maanden persoonlijke begeleiding met veertien dagen op Bonaire, India, Mauritius of Marbella als keerpunt." current="home" og="home">
<section class="opening" aria-labelledby="hero-t">
  <Photo src="photography/aurora-red-sea" alt="Open zee vlak voor zonsopkomst, een band van mineraalrood licht boven een rotsige kust." style="--focal:40% 55%" priority />
  <div class="shade" aria-hidden="true"></div>
  <div class="copy"><div class="wrap">
    <span class="eyebrow">Een sanctuary, geen kliniek</span>
    <h1 class="display" id="hero-t" style="max-width:none">Zes maanden begeleiding.<br> Veertien dagen keerpunt.</h1>
    <span class="coords">Bonaire · India · Mauritius · Marbella</span>
  </div></div>
  <span class="cue" aria-hidden="true"></span>
</section>

<section class="section" aria-labelledby="st-t"><div class="wrap still reveal">
  <span class="eyebrow" id="st-t">AURORA Private</span>
  <p class="statement">Voor wie functioneert, maar voelt dat het zo niet verder kan.</p>
  <span class="rule" aria-hidden="true"></span>
  <p class="soft">Eén vaste begeleider. Hooguit zes deelnemers. Geen wachtkamer, geen dossier, geen naam op een lijst.</p>
</div></section>

<section class="section section--tight-top" id="bestemmingen" aria-labelledby="best-t"><div class="wrap">
  <div class="head reveal">
    <div class="stack"><span class="eyebrow">Vier bestemmingen</span><h2 class="h2" id="best-t">Waar het keerpunt ligt.</h2></div>
    <p class="soft small">Overal hetzelfde traject. Bonaire opent als eerste.</p>
  </div>
  <div class="dests reveal">
    {locations.map((l) => (
      <a class="dest" href={`/${l.key}`}>
        <Photo src={l.photo} alt={l.alt} style={`--focal:${l.focal}`} sizes="(max-width: 960px) 50vw, 25vw" />
        <span class="info">
          <span class:list={['status', { open: l.open }]}><i aria-hidden="true"></i>{l.open ? 'Editie 01' : 'Wachtlijst'}</span>
          <h3>{l.name}</h3>
          <span class="hint">{hints[l.key]}</span>
        </span>
      </a>
    ))}
  </div>
</div></section>

<section class="section" id="traject" aria-labelledby="traject-t"><div class="wrap">
  <div class="head reveal">
    <div class="stack"><span class="eyebrow">Het traject</span><h2 class="h2" id="traject-t">Het begint voor je vertrekt.</h2></div>
    <a class="link" href="/traject">Dag voor dag <Fragment set:html={arrow} /></a>
  </div>
  <div class="trio reveal">
    <div><span class="n num">4<small>weken</small></span><h3>Voorbereiding</h3><p>Intake, je vaste begeleider en een eigen AURORA Plan.</p></div>
    <div class="core"><span class="n num">14<small>dagen</small></span><h3>Op locatie</h3><p>Vertragen, eerlijk kijken, je leven thuis opnieuw vormgeven.</p></div>
    <div><span class="n num">5<small>maanden</small></span><h3>Integratie</h3><p>Sessies thuis en evaluaties tot dag 180. Dezelfde begeleider.</p></div>
  </div>
</div></section>

<section class="interlude" aria-labelledby="verblijf-t">
  <Photo src="photography/aurora-red-room" alt="Ochtendlicht op kalkpleister in een rustige kamer, een raam open en een rode linnen plaid op een houten bank." />
  <div class="shade" aria-hidden="true"></div>
  <div class="copy"><div class="wrap">
    <span class="eyebrow">Het verblijf</span>
    <h2 class="statement" id="verblijf-t" style="margin-top:20px">Een eigen kamer. Een vast ritme. Ruimte voor stilte.</h2>
    <p class="meta">Privé chef · Transfers · Excursies in het ritme</p>
  </div></div>
</section>

<section class="section" id="editie" aria-labelledby="editie-t"><div class="wrap">
  <div class="edition reveal">
    <span class="eyebrow" id="editie-t">Editie 01 · Bonaire</span>
    <div class="price num">€17.500</div>
    <p class="soft">Het volledige traject van zes maanden. Niet de prijs van twee weken.</p>
    <div class="seats" role="img" aria-label="Zes plekken per editie"><span></span><span></span><span></span><span></span><span></span><span></span></div>
    <div class="actions">
      <a class="btn" href="#gesprek">Een eerste gesprek</a>
      <a class="btn btn--ghost" href="/particulier-of-zakelijk">Particulier of zakelijk</a>
    </div>
  </div>
</div></section>

<section class="section section--s band" aria-labelledby="voor-t"><div class="wrap">
  <div class="head reveal" style="margin-bottom:0">
    <div class="stack"><span class="eyebrow" id="voor-t">Je vraagt voor een ander</span><p class="lead">Voor iemand van wie je houdt, of voor iemand in je organisatie. Meedoen blijft een eigen keuze.</p></div>
    <div class="actions"><a class="btn btn--ghost" href="/voor-naasten">Voor naasten</a><a class="btn btn--ghost" href="/organisaties">Voor organisaties</a></div>
  </div>
</div></section>

<IntakeSection />
</Base>

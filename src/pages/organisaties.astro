---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import IntakeSection from '../components/IntakeSection.astro';
---
<Base title="Voor organisaties · AURORA Private" description="Discrete begeleiding voor een medewerker die vastloopt: veertien dagen afwezig, zes maanden begeleiding, zakelijke facturatie en één liaison voor HR." og="organisaties" crumbs={[{ name: 'Voor organisaties', path: '/organisaties' }]}>
<PageHero photo="unsplash:1497366811353-6870744d04b2" alt="Een lege vergaderruimte met een lange tafel en stoelen." eyebrow="Voor organisaties" title="Veertien dagen afwezig. Zes maanden begeleid." sub="Voor de mensen op wie uw organisatie rust." focal="50% 60%" />

<section class="section tone-night" aria-labelledby="w-t"><div class="wrap still reveal">
  <span class="eyebrow" id="w-t">Kort weg, lang begeleid</span>
  <p class="statement">De afwezigheid is <em>planbaar</em>. Het zwaartepunt ligt thuis, naast het werk.</p>
  <span class="rule" aria-hidden="true"></span>
  <p class="soft">Vier weken voorbereiding, veertien dagen op locatie, vijf maanden integratie. Dezelfde begeleider, het hele traject.</p>
</div></section>

<section class="section section--tight-top tone-dusk" aria-labelledby="hoe-t"><div class="wrap">
  <div class="head reveal"><div class="stack"><span class="eyebrow">Hoe het werkt</span><h2 class="h2" id="hoe-t">Zakelijk geregeld. <em>Persoonlijk</em> gehouden.</h2></div></div>
  <ol class="steps reveal">
    <li><div><h3>Verkennend gesprek, zonder namen</h3><p>Past AURORA bij de situatie, en hoe verhoudt het zich tot werk en verlof?</p></div></li>
    <li><div><h3>De medewerker kiest zelf</h3><p>Een eigen intake met de begeleider, los van de werkgever.</p></div></li>
    <li><div><h3>Eén liaison, zakelijke factuur</h3><p>Dezelfde voorwaarden als particulier: €17.500 voor zes maanden.</p></div></li>
    <li><div><h3>De medewerker houdt de regie</h3><p>Wat gedeeld wordt, legt u per opdracht schriftelijk vast met de deelnemer.</p></div></li>
  </ol>
</div></section>

<section class="section section--s tone-dawn" aria-labelledby="d-t"><div class="wrap">
  <div class="facts-row reveal">
    <div><b>6</b><span>Deelnemers per editie</span></div>
    <div><b>0</b><span>Rapportage zonder toestemming</span></div>
    <div><b>1</b><span>Liaison voor HR</span></div>
    <div><b>0</b><span>Cookies of tracking</span></div>
  </div>
  <h2 class="sr" id="d-t">Discretie</h2>
</div></section>

<IntakeSection title="Een verkennend gesprek." lead="Kies ‘Voor mijn organisatie’. Zonder namen tot u daar klaar voor bent." />
</Base>

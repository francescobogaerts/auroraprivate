---
// Replaces the v1 Zilveren Kruis blog; states only what AURORA itself controls. See README › Nog open.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import IntakeSection from '../components/IntakeSection.astro';
---
<Base title="Particulier of zakelijk · AURORA Private" description="€17.500 voor het volledige traject van zes maanden. Zelf betalen of via je werkgever, op dezelfde voorwaarden. Waarom AURORA geen vergoede zorg is." og="betalen" crumbs={[{ name: 'Particulier of zakelijk', path: '/particulier-of-zakelijk' }]}>
<PageHero photo="img/marbella-garden" alt="Een lange houten tafel onder olijfbomen, bergen in de verte." eyebrow="Particulier of zakelijk" title="Eén prijs. Twee manieren om te betalen." focal="45% 60%" />

<section class="section tone-night" aria-labelledby="p-t"><div class="wrap">
  <div class="edition reveal">
    <span class="eyebrow" id="p-t">Het volledige traject</span>
    <div class="price num">€17.500</div>
    <p class="soft">Zes maanden. Verblijf, privé chef, transfers, excursies en alle sessies. Niet de prijs van twee weken.</p>
  </div>
</div></section>

<section class="section section--tight-top tone-dusk" aria-labelledby="twee-t"><div class="wrap">
  <h2 class="sr" id="twee-t">Particulier of zakelijk</h2>
  <div class="trio reveal" style="grid-template-columns:1fr 1fr">
    <div><span class="eyebrow">Particulier</span><h3 style="font:400 clamp(1.8rem,1.3rem + 1.4vw,2.6rem)/1.1 var(--font-display);letter-spacing:-.01em">Je betaalt <em>zelf</em>.</h3><p>De factuur op je eigen naam. Geen verzekeraar, werkgever of dossier buiten AURORA.</p></div>
    <div><span class="eyebrow">Zakelijk</span><h3 style="font:400 clamp(1.8rem,1.3rem + 1.4vw,2.6rem)/1.1 var(--font-display);letter-spacing:-.01em">Je werkgever betaalt.</h3><p>Eén liaison voor HR, dezelfde voorwaarden. Wat gedeeld wordt, bepaal jij. <a href="/organisaties">Voor organisaties</a></p></div>
  </div>
</div></section>

<section class="section section--s tone-dawn" aria-labelledby="v-t"><div class="wrap still reveal">
  <span class="eyebrow" id="v-t">Zorgverzekering</span>
  <p class="statement">Geen behandeling, dus geen <em>vergoede</em> zorg.</p>
  <p class="soft">Heb je medische zorg of ggz nodig, dan is dat de eerste stap, via je huisarts. Bij de intake kijken we samen wat past.</p>
</div></section>

<IntakeSection />
</Base>

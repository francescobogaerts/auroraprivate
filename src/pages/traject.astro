---
// Het traject — canon: Programma 2.0 (Claude Docs, 8 okt 2026). Copy blocks are verbatim where the canon says so.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import IntakeSection from '../components/IntakeSection.astro';

const days: [string, string, string, string, string][] = [
  ['Aankomen', 'Ontvangst, niets moet', 'Kennismaking op locatie', 'Zwemmen, rust', 'Welkomstdiner met de editie'],
  ['Vertragen', 'Ademwerk, intenties uitspreken', '—', 'Snorkelen bij het huisrif', 'Zonsondergang, vroeg slapen'],
  ['Waar sta je', 'Workshop: het eerlijke inventaris', 'Sessie 1', 'Wandeling Washington Slagbaai', 'Vrije avond'],
  ['Wat het je kost', 'Workshop: patronen en hun prijs', '—', 'Kajak, mangroven Lac Bay', 'Chef’s table'],
  ['Lichaam', 'Beweging, slaap, voeding', 'Sessie 2', 'Vrij', 'Sterrenhemel, stilte'],
  ['Wat je meedraagt', 'Workshop: herstel en verlies', '—', 'Zeilen naar Klein Bonaire', 'Groepsgesprek bij vuur'],
  ['Stilte', 'Geen programma', 'Op verzoek', 'Eigen keuze', 'Eigen keuze'],
  ['Relaties', 'Workshop: wie om je heen staat', 'Sessie 3', 'Ezelopvang, flamingo’s Pekelmeer', 'Vrije avond'],
  ['Verantwoordelijkheid', 'Workshop: wat van jou is', '—', 'Duiken of strand', 'Diner in de stad'],
  ['Emoties', 'Workshop: voelen zonder vluchten', 'Sessie 4', 'Massage, vrije middag', 'Muziek, informeel'],
  ['Stilte', 'Geen programma', 'Op verzoek', 'Eigen keuze', 'Eigen keuze'],
  ['Identiteit', 'Workshop: wie je bent zonder rol', 'Sessie 5', 'Zeilen, zwemmen', 'Vrije avond'],
  ['Thuis', 'Workshop: je leven thuis opnieuw ingericht', 'Sessie 6: je integratieplan', 'Vrij', 'Afscheidsdiner'],
  ['Vertrek', 'Afsluitende cirkel, afspraak dag 30', '—', 'Transfer', '—'],
];
const moves: Record<number, string> = { 0: 'Aankomen · dag 1–4', 4: 'Kijken · dag 5–11', 11: 'Vormgeven · dag 12–14' };
---
<Base title="Het traject · AURORA Private" description="Zes maanden persoonlijke begeleiding met veertien dagen op locatie als keerpunt. Voorbereiding, de veertien dagen dag voor dag, integratie en de prijs." og="traject" current={null} crumbs={[{ name: 'Het traject', path: '/traject' }]}>
<PageHero photo="unsplash:1781969472422-41e137ffe157" alt="Laag licht boven zee en een donkere kustlijn." eyebrow="Het traject" title="Het begint voor je vertrekt." sub="En houdt niet op als je thuiskomt." coords="4 weken · 14 dagen · 5 maanden" focal="40% 60%" />

<section class="section tone-night" aria-labelledby="fases-t"><div class="wrap">
  <div class="head reveal"><div class="stack"><span class="eyebrow">Drie fases</span><h2 class="h2" id="fases-t">Eén begeleider, van intake tot dag <em>180</em>.</h2></div></div>
  <div class="phases reveal" style="margin-top:0">
    <article><span class="when">± 4 weken · thuis</span><h3>Voorbereiding</h3><p>Intake, je vaste begeleider en een eigen AURORA Plan.</p>
      <details class="more"><summary>Meer</summary><div><p>Het traject begint voor vertrek. Een persoonlijke intake en screening, gesprekken met je vaste begeleider, je doelen en patronen in kaart. Je vertrekt met een eigen AURORA Plan, niet met een koffer vol vragen.</p></div></details></article>
    <article class="core"><span class="when">14 dagen · op locatie</span><h3>The Bonaire Experience</h3><p>Vertragen, eerlijk kijken, je leven thuis opnieuw vormgeven.</p>
      <details class="more"><summary>Meer</summary><div><p>Het hart van het traject. Geen kliniek, maar een veilige, rustige plek met hooguit zes anderen. Eerst vertragen en eerlijk kijken. Dan patronen, relaties en verantwoordelijkheid. Dan je leven thuis opnieuw vormgeven. Daartussen: zee, stilte, goed eten, beweging en plezier. Niet elke minuut is begeleiding.</p></div></details></article>
    <article><span class="when">± 5 maanden · thuis</span><h3>Integratie</h3><p>Sessies thuis en evaluaties op dag 30, 60, 90 en 180.</p>
      <details class="more"><summary>Meer</summary><div><p>Na Bonaire verdwijnt AURORA niet. Eerst wekelijks een 1-op-1 sessie, later tweewekelijks. Groepssessies met je editie, persoonlijke opdrachten en evaluaties op dag 30, 60, 90 en 180. Dezelfde begeleider, het hele traject.</p></div></details></article>
  </div>
</div></section>

<section class="section tone-dusk" id="veertien" aria-labelledby="dagen-t"><div class="wrap">
  <div class="head reveal"><div class="stack"><span class="eyebrow">De veertien dagen</span><h2 class="h2" id="dagen-t">Dag voor dag.</h2></div><p class="soft small">Ochtend samen · middag lichaam en eiland · avond licht. Dag 7 en 11 zijn stil.</p></div>
  <div class="daytable-wrap reveal" role="region" aria-label="Programma van de veertien dagen" tabindex="0">
    <table class="daytable">
      <thead><tr><th scope="col">Dag</th><th scope="col">Thema</th><th scope="col">Ochtend, samen</th><th scope="col">1-op-1</th><th scope="col">Middag &amp; eiland</th><th scope="col">Avond</th></tr></thead>
      <tbody>
        {days.map((d, i) => (
          <>
            {moves[i] && <tr class="move"><td colspan="6">{moves[i]}</td></tr>}
            <tr class:list={{ quiet: d[0] === 'Stilte' }}><td data-l="Dag">{i + 1}</td><td data-l="Thema">{d[0]}</td><td data-l="Ochtend">{d[1]}</td><td data-l="1-op-1">{d[2]}</td><td data-l="Middag">{d[3]}</td><td data-l="Avond">{d[4]}</td></tr>
          </>
        ))}
      </tbody>
    </table>
  </div>
  <p class="credit" style="margin-top:20px">Eerste ontwerp; de begeleiders vullen en toetsen het voor de eerste editie. India, Mauritius en Marbella volgen hetzelfde ritme.</p>
</div></section>

<section class="section section--s tone-dawn" id="editie" aria-labelledby="prijs-t"><div class="wrap edition reveal">
  <span class="eyebrow" id="prijs-t">Editie 01 · Bonaire</span>
  <div class="price num">€17.500</div>
  <p class="soft">Het volledige traject van zes maanden. Maximaal zes deelnemers.</p>
  <div class="actions"><a class="btn" href="#gesprek">Een eerste gesprek</a><a class="btn btn--ghost" href="/particulier-of-zakelijk">Particulier of zakelijk</a></div>
</div></section>

<section class="section tone-day" id="meedoen" aria-labelledby="mee-t"><div class="wrap still reveal">
  <span class="eyebrow">Wie kan meedoen</span>
  <p class="statement" id="mee-t">Een eerlijke intake, ook als het antwoord <em>nee</em> is.</p>
  <details class="more"><summary>Toelating en doorverwijzing</summary><div style="text-align:left">
    <div class="cols2" style="margin-top:0">
      <div><h3 class="h3">Je kunt meedoen als je</h3><ul class="ticklist">
        <li>stabiel genoeg bent om zonder medisch toezicht te reizen en veertien dagen in een kleine groep te zijn;</li>
        <li>zelf kiest voor het traject, niet onder druk van werkgever of familie;</li>
        <li>bereid bent tot zes maanden begeleiding, ook na thuiskomst.</li>
      </ul></div>
      <div><h3 class="h3">We verwijzen door bij</h3><ul class="ticklist">
        <li>lichamelijke afhankelijkheid waarbij stoppen medisch begeleid moet worden;</li>
        <li>acute crisis, psychose of een actieve eetstoornis;</li>
        <li>een lopende behandeling die door deelname onderbroken zou worden, zonder akkoord van de behandelaar.</li>
      </ul></div>
    </div>
  </div></details>
</div></section>

<IntakeSection />
</Base>

---
import Brand from './Brand.astro';
import { LOCATIONS } from '../data/site';
interface Props { talk: string }
const { talk } = Astro.props;
---
<footer class="site-foot"><div class="wrap">
  <div class="mark">
    <Brand />
    <p class="bound">AURORA Private is een begeleidingstraject, geen behandeling. We bieden geen detox, geen medische zorg en geen vervanging voor ggz-behandeling. Heb je die nodig, dan helpen we je bij de intake de juiste plek te vinden.</p>
  </div>
  <nav aria-label="Voettekst">
    {LOCATIONS.map((l) => <a href={`/${l.key}`}>{l.name}</a>)}
    <a href="/traject">Het traject</a>
    <a href="/organisaties">Organisaties</a>
    <a href="/voor-naasten">Naasten</a>
    <a href="/vragen">Vragen</a>
    <a href="/privacy">Privacy</a>
    <a href={talk}>Eerste gesprek</a>
  </nav>
  <div class="legal"><span>Een sanctuary, geen kliniek · Esc sluit deze site direct</span><span>Beelden zijn sfeerconcepten en tijdelijke stockfoto’s.</span></div>
</div></footer>

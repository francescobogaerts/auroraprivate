---
// Responsive, art-directed photo. Every image is resized at build time into
// AVIF + WebP + JPEG at several widths, so phones never download the 1672px master.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: string;            // "img/kb-1" or "photography/aurora-red-sea"
  alt?: string;
  class?: string;         // extra classes on the <figure> (e.g. "thumb")
  style?: string;         // e.g. "--focal:40% 55%"
  priority?: boolean;     // above the fold: eager + fetchpriority high
  sizes?: string;
}

const { src, alt = '', class: cls = '', style, priority = false, sizes } = Astro.props;
const all = import.meta.glob<{ default: ImageMetadata }>('/src/assets/**/*.{jpg,jpeg,png}', { eager: true });
const key = `/src/assets/${src}.jpg`;
const mod = all[key] ?? all[`/src/assets/${src}.png`];
if (!mod) throw new Error(`Photo not found: ${src}`);

const isThumb = /\bthumb\b/.test(cls);
const resolvedSizes = sizes ?? (isThumb ? '(max-width: 860px) 100vw, 34vw' : '100vw');
const widths = isThumb ? [400, 640, 900] : [640, 960, 1280, 1672];
---
<figure class:list={['photo', cls]} style={style}>
  <Picture
    src={mod.default}
    alt={alt}
    formats={['avif', 'webp']}
    fallbackFormat="jpg"
    widths={widths.filter((w) => w <= mod.default.width)}
    sizes={resolvedSizes}
    quality={72}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding={priority ? 'sync' : 'async'}
  />
  <slot />
</figure>
